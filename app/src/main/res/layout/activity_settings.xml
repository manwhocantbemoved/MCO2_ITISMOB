<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SettingsActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Automation Rules"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- SENSITIVITY -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Sensitivity: how long you stay still before you're Settled"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSensitivityValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15 minutes" />

            <SeekBar
                android:id="@+id/seekSensitivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="40" />

            <!-- QUIET HOURS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Quiet Hours"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchQuiet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mute settled notifications" />

            <Button
                android:id="@+id/btnQuietStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="From: 10:00 PM" />

            <Button
                android:id="@+id/btnQuietEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Until: 7:00 AM" />

            <!-- LOCATION BLACKLIST -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Location Blacklist"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBlacklist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No places added yet" />

            <Button
                android:id="@+id/btnAddBlacklist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Current Location" />

            <Button
                android:id="@+id/btnClearBlacklist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear Blacklist" />

            <!-- ACCOUNT -->
            <Button
                android:id="@+id/btnSignOut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Sign Out" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>