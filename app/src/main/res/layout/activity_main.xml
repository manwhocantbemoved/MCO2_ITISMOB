<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

            <!-- 1. STATUS CARD -->
            <LinearLayout
                android:id="@+id/statusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Studio Desk"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Moving" />

                <TextView
                    android:id="@+id/tvStatusMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You're on the move. We'll suggest tasks when you settle." />

                <TextView
                    android:id="@+id/tvWindow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No free window yet" />

                <Button
                    android:id="@+id/btnToggleStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Simulate: I'm settled" />
            </LinearLayout>

            <!-- FILTER ROW -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Adaptive View"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <Button
                    android:id="@+id/btnFilterAll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="All" />

                <Button
                    android:id="@+id/btnFilterShort"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Under 30m" />

                <Button
                    android:id="@+id/btnFilterHigh"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="High" />
            </LinearLayout>

            <!-- 2. HEADING -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:text="Suggested for Now"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- 3. SWIPE CARDS -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <!-- CARD 1 -->
                    <LinearLayout
                        android:id="@+id/taskCard"
                        android:layout_width="280dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="#EEEEEE">

                        <TextView
                            android:id="@+id/tvTaskName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Review Mobile Prototype Flow"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTaskInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="High priority - 25 min" />

                        <Button
                            android:id="@+id/btnStartFocus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Start Focus Timer (25m)" />
                    </LinearLayout>

                    <!-- CARD 2 -->
                    <LinearLayout
                        android:id="@+id/taskCard2"
                        android:layout_width="280dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="#EEEEEE">

                        <TextView
                            android:id="@+id/tvTaskName2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Workout"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTaskInfo2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Medium priority - 45 min" />

                        <Button
                            android:id="@+id/btnStartFocus2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Start Focus Timer (45m)" />
                    </LinearLayout>

                    <!-- CARD 3 -->
                    <LinearLayout
                        android:id="@+id/taskCard3"
                        android:layout_width="280dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="#EEEEEE">

                        <TextView
                            android:id="@+id/tvTaskName3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Study"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTaskInfo3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Low priority - 30 min" />

                        <Button
                            android:id="@+id/btnStartFocus3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Start Focus Timer (30m)" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>
            <!-- FOCUS MOMENTUM -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:text="Focus Momentum"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#EEEEEE">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daily Sprint Cadence: 3/4"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="75m total focused out of 100m goal" />

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="75" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Daily Streak\n6 Days" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Avg. Flow\n28 min" />
                </LinearLayout>
            </LinearLayout>
            <!-- IMMEDIATE TO-DO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Immediate To-Do"
                android:textSize="18sp"
                android:textStyle="bold" />
            <CheckBox
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Draft project brief summary - Due in 25 mins" />
        </LinearLayout>
    </ScrollView>
    <!-- NAVBAR AT THE BOTTOM -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Create task"
        app:srcCompat="@android:drawable/ic_input_add"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>