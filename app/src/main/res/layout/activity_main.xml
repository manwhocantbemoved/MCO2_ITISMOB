<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/helloworld"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TaskEase"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--FOR THE NAVBAR AT THE BOTTOM-->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:contentDescription="Create task"
        app:srcCompat="@android:drawable/ic_input_add"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"/>

    <HorizontalScrollView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="80dp"
            android:clipToPadding="false">

            <!-- CARD 1 -->
            <LinearLayout
                android:id="@+id/taskCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#EEEEEE">

                <TextView
                    android:id="@+id/tvTaskName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Review Mobile Prototype Flow"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTaskInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="High priority • 25 min" />

                <Button
                    android:id="@+id/btnStartFocus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Start Focus Timer (25m)" />
            </LinearLayout>

            <!-- CARD 2 -->
            <LinearLayout
                android:id="@+id/taskCard2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#EEEEEE">

                <TextView
                    android:id="@+id/tvTaskName2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Workout"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTaskInfo2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medium priority - 45 min" />

                <Button
                    android:id="@+id/btnStartFocus2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start Focus Timer (45m)" />
            </LinearLayout>

            <!-- CARD 3 -->
            <LinearLayout
                android:id="@+id/taskCard3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#EEEEEE">

                <TextView
                    android:id="@+id/tvTaskName3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Study"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTaskInfo3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Low priority - 30 min" />

                <Button
                    android:id="@+id/btnStartFocus3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start Focus Timer (30m)" />
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>